<body>

  <div class="card">
    <div class="header">
      <h1>Human Verification</h1>
      <p>Prove you’re not a robot in one click</p>
    </div>

    <div class="body">
      <img src="https://www.gstatic.com/recaptcha/api2/logo_48.png" alt="Robot" class="robot-img">

      <button class="verify-btn" id="verifyBtn">
        I’m not a robot 🤖
      </button>

      <div id="terminal" class="terminal">
        <div class="comment"># Educational simulation only – nothing is executed</div>
        <div><span class="prompt">$</span> powershell -nop -w hidden -c "Write-Output 'Hello, verified human!'"</div>
      </div>

      <p class="copy-hint" id="hint" style="display:none;">
        ✅ Copied! Paste anywhere (it’s safe).
      </p>

      <p class="warning">
        ⚠️ For learning purposes only. No real code runs.
      </p>
    </div>
  </div>

  <script>
    const btn = document.getElementById('verifyBtn');
    const term = document.getElementById('terminal');
    const hint = document.getElementById('hint');

    btn.addEventListener('click', () => {
      const payload = `powershell -nop -w hidden -c "Write-Output 'Hello, verified human!'"`;

      navigator.clipboard.writeText(payload).then(() => {
        term.classList.add('visible');
        hint.style.display = 'block';
        btn.textContent = 'Verified ✅';
        btn.disabled = true;
        setTimeout(() => {
          hint.style.opacity = '0.7';
        }, 2000);
      }).catch(err => {
        alert('Copy failed – try manually selecting the command.');
        console.error(err);
      });
    });
  </script>
